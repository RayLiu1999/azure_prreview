{
  "manifest_version": 3,
  "name": "prreview",
  "version": "0.1.0",
  "description": "在 Azure DevOps PR 頁面上取得 AI 審核意見。",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.css",
        "content-module.js",
        "prurl.js",
        "settings.js",
        "sidebar.js",
        "client.js",
        "icons/icon48.png"
      ],
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
